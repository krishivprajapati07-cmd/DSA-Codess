class Node:
    def __init__(self, employee_id):
        self.employee_id = employee_id
        self.next = None


class EmployeeList:
    def __init__(self):
        self.head = None

    # Insert employee at the end
    def insert(self, employee_id):
        new_node = Node(employee_id)

        if self.head is None:
            self.head = new_node
            return

        temp = self.head

        while temp.next is not None:
            temp = temp.next

        temp.next = new_node

    # Delete employee from the head
    def delete_head(self):
        if self.head is None:
            print("Employee list is empty.")
            return

        print("Deleted Employee:", self.head.employee_id)

        # Move head to the next node
        self.head = self.head.next

    # Display employee list
    def display(self):
        if self.head is None:
            print("Employee list is empty.")
            return

        temp = self.head

        while temp is not None:
            print(temp.employee_id, end="")

            if temp.next is not None:
                print(" -> ", end="")

            temp = temp.next

        print()


# Create employee list
employees = EmployeeList()

# E201 -> E202 -> E203 -> E204 -> E205
employees.insert("E201")
employees.insert("E202")
employees.insert("E203")
employees.insert("E204")
employees.insert("E205")

# 1. Display employee list
print("Original Employee List:")
employees.display()

# 2. Delete E201 (head node)
employees.delete_head()

# 3. Display updated list
print("\nUpdated Employee List:")
employees.display()
