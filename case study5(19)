class Node:
    def __init__(self, user_id):
        self.user_id = user_id
        self.left = None
        self.right = None


class BST:
    def __init__(self):
        self.root = None

    # Insert a user ID dynamically
    def insert(self, user_id):
        new_node = Node(user_id)

        if self.root is None:
            self.root = new_node
            return

        current = self.root

        while True:
            if user_id < current.user_id:
                if current.left is None:
                    current.left = new_node
                    return
                current = current.left

            elif user_id > current.user_id:
                if current.right is None:
                    current.right = new_node
                    return
                current = current.right

            else:
                print("Duplicate User ID not allowed:", user_id)
                return

    # -------------------------------
    # RECURSIVE TRAVERSALS
    # -------------------------------

    # Recursive Preorder: Root -> Left -> Right
    def recursive_preorder(self, root, result):
        if root is not None:
            result.append(root.user_id)
            self.recursive_preorder(root.left, result)
            self.recursive_preorder(root.right, result)

    # Recursive Inorder: Left -> Root -> Right
    def recursive_inorder(self, root, result):
        if root is not None:
            self.recursive_inorder(root.left, result)
            result.append(root.user_id)
            self.recursive_inorder(root.right, result)

    # Recursive Postorder: Left -> Right -> Root
    def recursive_postorder(self, root, result):
        if root is not None:
            self.recursive_postorder(root.left, result)
            self.recursive_postorder(root.right, result)
            result.append(root.user_id)

    # -------------------------------
    # NON-RECURSIVE TRAVERSALS
    # -------------------------------

    # Non-recursive Preorder
    def nonrecursive_preorder(self):
        if self.root is None:
            return []

        stack = [self.root]
        result = []

        while stack:
            current = stack.pop()
            result.append(current.user_id)

            # Push right first so left is processed first
            if current.right:
                stack.append(current.right)

            if current.left:
                stack.append(current.left)

        return result

    # Non-recursive Inorder
    def nonrecursive_inorder(self):
        stack = []
        result = []
        current = self.root

        while stack or current:
            # Go to the leftmost node
            while current:
                stack.append(current)
                current = current.left

            current = stack.pop()
            result.append(current.user_id)

            current = current.right

        return result

    # Non-recursive Postorder
    def nonrecursive_postorder(self):
        if self.root is None:
            return []

        stack1 = [self.root]
        stack2 = []
        result = []

        while stack1:
            current = stack1.pop()
            stack2.append(current)

            if current.left:
                stack1.append(current.left)

            if current.right:
                stack1.append(current.right)

        while stack2:
            current = stack2.pop()
            result.append(current.user_id)

        return result


# -----------------------------------
# MAIN PROGRAM
# -----------------------------------

bst = BST()

n = int(input("Enter number of users: "))

print("Enter User IDs:")

for i in range(n):
    user_id = int(input("User ID: "))
    bst.insert(user_id)


# Recursive traversals
pre_recursive = []
in_recursive = []
post_recursive = []

bst.recursive_preorder(bst.root, pre_recursive)
bst.recursive_inorder(bst.root, in_recursive)
bst.recursive_postorder(bst.root, post_recursive)

# Non-recursive traversals
pre_nonrecursive = bst.nonrecursive_preorder()
in_nonrecursive = bst.nonrecursive_inorder()
post_nonrecursive = bst.nonrecursive_postorder()


# Display results
print("\n--- Traversal Comparison ---")

print("\nPreorder:")
print("Recursive     :", pre_recursive)
print("Non-Recursive :", pre_nonrecursive)

print("\nInorder:")
print("Recursive     :", in_recursive)
print("Non-Recursive :", in_nonrecursive)

print("\nPostorder:")
print("Recursive     :", post_recursive)
print("Non-Recursive :", post_nonrecursive)


# Compare results
print("\n--- Comparison ---")

print("Preorder :", pre_recursive == pre_nonrecursive)
print("Inorder  :", in_recursive == in_nonrecursive)
print("Postorder:", post_recursive == post_nonrecursive)
