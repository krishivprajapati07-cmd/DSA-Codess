class Node:
    def __init__(self, product_id):
        self.product_id = product_id
        self.next = None


class ShoppingCart:
    def __init__(self):
        self.head = None

    # Insert product at the end
    def insert(self, product_id):
        new_node = Node(product_id)

        if self.head is None:
            self.head = new_node
            return

        temp = self.head

        while temp.next is not None:
            temp = temp.next

        temp.next = new_node

    # Delete product
    def delete(self, product_id):
        if self.head is None:
            print("Cart is empty.")
            return

        # If product is the first node
        if self.head.product_id == product_id:
            self.head = self.head.next
            print("Product", product_id, "deleted.")
            return

        temp = self.head

        while temp.next is not None:
            if temp.next.product_id == product_id:
                temp.next = temp.next.next
                print("Product", product_id, "deleted.")
                return

            temp = temp.next

        print("Product", product_id, "not found.")

    # Display product list
    def display(self):
        if self.head is None:
            print("Cart is empty.")
            return

        temp = self.head

        while temp is not None:
            print(temp.product_id, end="")

            if temp.next is not None:
                print(" -> ", end="")

            temp = temp.next

        print()


# Create shopping cart
cart = ShoppingCart()

# Current List: 501 -> 502 -> 503 -> 504
cart.insert(501)
cart.insert(502)
cart.insert(503)
cart.insert(504)

# 1. Display the product list
print("Original Product List:")
cart.display()

# 2. Insert Product 505
cart.insert(505)

print("\nAfter inserting Product 505:")
cart.display()

# 3. Delete Product 503
cart.delete(503)

# 4. Display final list
print("\nFinal Product List:")
cart.display()
